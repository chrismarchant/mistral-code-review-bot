# Mistral API key (https://console.mistral.ai)
MISTRAL_API_KEY=

# The ID of your GitHub App (self-hosted app mode)
APP_ID=
WEBHOOK_SECRET=
PRIVATE_KEY=

# Use `trace` to get verbose logging or `info` to show less
LOG_LEVEL=debug

# BOT settings
MODEL=mistral-large-latest # e.g. mistral-large-latest, codestral-latest, devstral-latest, mistral-small-latest
MISTRAL_API_ENDPOINT=https://api.mistral.ai/v1 # override for proxies / compatible endpoints
LANGUAGE=
temperature=1
top_p=1
max_tokens=
TARGET_LABEL=
MAX_PATCH_LENGTH=
# concurrency / reliability knobs
MAX_CONCURRENCY=5 # max parallel Mistral API calls across all files/chunks of a PR
CHUNK_MAX_LINES=200 # split large diffs into chunks of at most this many hunk lines
REQUEST_TIMEOUT_MS=120000 # per-request timeout
RETRY_ATTEMPTS=3 # retries on 429/5xx/network errors
RETRY_BASE_DELAY_MS=500 # backoff base (exponential + jitter)
PROMPT=Below there is a code diff please help me do a code review
IGNORE_PATTERNS=/node_modules/**/*,*.md # glob pattern or regex pattern to ignore files, separated by comma
INCLUDE_PATTERNS=*.js,*.ts # glob pattern or regex pattern to include files, separated by comma
